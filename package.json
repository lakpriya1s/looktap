{
  "name": "@looktap/cli",
  "version": "0.2.1",
  "description": "Let AI agents drive iPhone and Android devices from the shell: read the screen, tap, type, swipe, screenshot, read logs and crashes. No server to start and zero dependencies.",
  "keywords": [
    "ios-simulator",
    "ios-device",
    "real-device",
    "android-emulator",
    "android-device",
    "mobile-automation",
    "ai-agents",
    "claude-code",
    "cli",
    "appium-alternative",
    "react-native",
    "simctl",
    "adb"
  ],
  "author": "Lakpriya Senevirathna",
  "license": "AGPL-3.0-only",
  "homepage": "https://lakpriya1s.github.io/looktap/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lakpriya1s/looktap.git"
  },
  "bugs": {
    "url": "https://github.com/lakpriya1s/looktap/issues"
  },
  "type": "module",
  "bin": {
    "looktap": "bin/looktap.js"
  },
  "files": [
    "bin",
    "lib",
    "native",
    "skills",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "build:ios": "sh native/ios/build.sh",
    "build:android": "sh native/android/build.sh",
    "site:build": "node site/build.mjs",
    "site:serve": "node site/serve.mjs"
  }
}
