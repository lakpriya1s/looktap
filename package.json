{
  "name": "simwright",
  "version": "0.1.1",
  "description": "Let AI agents drive an iOS simulator or Android emulator from the shell: read the screen, tap, type, swipe, screenshot, read logs and crashes. Nothing to install on the device and no server to start.",
  "keywords": [
    "ios-simulator",
    "android-emulator",
    "mobile-automation",
    "ai-agents",
    "claude-code",
    "cli",
    "appium-alternative",
    "react-native",
    "simctl",
    "adb"
  ],
  "author": "Lakpriya Senevirathna",
  "license": "AGPL-3.0-only",
  "homepage": "https://lakpriya1s.github.io/simwright/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lakpriya1s/simwright.git"
  },
  "bugs": {
    "url": "https://github.com/lakpriya1s/simwright/issues"
  },
  "type": "module",
  "bin": {
    "simwright": "bin/simwright.js"
  },
  "files": [
    "bin",
    "lib",
    "native",
    "skills",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "build:ios": "sh native/ios/build.sh",
    "build:android": "sh native/android/build.sh",
    "site:build": "node site/build.mjs",
    "site:serve": "node site/serve.mjs"
  }
}
